#define GROUP_SIZE 1024

#pragma kernel CalcDepthSpark

uint _SplatCount;
int _GsplatProjectionMode;
int _PvgDynamic;
float _PvgTime;
float _PvgPeriod;
float4x4 _MatrixMV;
StructuredBuffer<uint4> _PackedSplatsBuffer;
StructuredBuffer<float2> _PvgTimeBuffer;
StructuredBuffer<float3> _PvgVelocityBuffer;
StructuredBuffer<uint> _OrderBuffer;
RWStructuredBuffer<float> _DepthBuffer;

#define GSPLAT_EPSILON 0.0000001

float3 ApplyPvgPosition(uint splatId, float3 position)
{
    if (_PvgDynamic == 0)
        return position;

    float2 pvgTimeData = _PvgTimeBuffer[splatId];
    float3 velocity = _PvgVelocityBuffer[splatId];
    float a = 2.0 * 3.14159265358979323846 / max(abs(_PvgPeriod), GSPLAT_EPSILON);
    return position + velocity * (sin((_PvgTime - pvgTimeData.x) * a) / a);
}

[numthreads(GROUP_SIZE,1,1)]
void CalcDepthSpark(uint3 id : SV_DispatchThreadID)
{
    uint idx = id.x;
    if (idx >= _SplatCount)
        return;

    uint splatId = _OrderBuffer[idx];
    uint4 word = _PackedSplatsBuffer[splatId];
    float3 pos = float3(f16tof32(word.y & 0xffffu), f16tof32((word.y >> 16u) & 0xffffu), f16tof32(word.z & 0xffffu));
    pos = ApplyPvgPosition(splatId, pos);
    pos = mul(_MatrixMV, float4(pos.xyz, 1)).xyz;
    _DepthBuffer[idx] = _GsplatProjectionMode == 1 ? -length(pos) : pos.z;
}
